# Shortcuts
alias copyssh="xclip -selection clipboard < $HOME/.ssh/id_ed25519.pub"
alias reloadshell="exec $SHELL"
alias reloaddns="sudo systemd-resolve --flush-caches"
if command -v eza >/dev/null 2>&1; then
    alias ls="eza"
    alias ll="eza -alh --group-directories-first"
    alias tree="eza --tree"
else
    alias ll="ls -AhlF --color=auto --group-directories-first"
fi
alias shrug="echo '¯\_(ツ)_/¯' | wl-copy"
alias timestamp="date +%s"
alias version="commit 'version'"

# Directories
DOTFILES=${DOTFILES:-"$HOME/dotfiles"}
alias library="cd $HOME/.local/share"
alias projects="cd $HOME/apps"
alias dotfiles="cd $DOTFILES"

# JS
alias nfresh="rm -rf node_modules/ package-lock.json && npm install"
alias nrd="npm run dev"

# Docker
alias docker-composer="docker compose"

# Git
alias gs="git status"
alias gb="git branch"
alias gc="git checkout"
alias gl="git log --oneline --decorate --color"
alias amend="git add . && git commit --amend --no-edit"
alias commit="git add . && git commit -m"
alias gdiff="git diff"
alias force="git push --force-with-lease"
alias nuke="git clean -df && git reset --hard"
alias pop="git stash pop"
alias prune="git fetch"
alias pull="git pull"
alias push="git push"
alias resolve="git add . && git commit --no-edit"
alias stash="git stash -u"
alias unstage="git restore --staged ."
alias wip="commit wip"

# Git worktree helper — creates worktrees in .worktrees/ subdir
gwa() {
  local branch="${1?Usage: gwa <branch-name> [base-branch]}"
  local base="${2:-HEAD}"
  local dir=".worktrees/${branch}"
  mkdir -p .worktrees
  git worktree add "$dir" -b "$branch" "$base"
  echo "Worktree ready: $dir"
}

# Terminal
alias gogh='bash -c "$(curl -sLo- https://git.io/vQgMr)"'

# Claude Code
alias claude-sync='cd ~/dotfiles && git add config/claude/ && git status'
alias tw='tmux-work'
