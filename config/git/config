# This is Git's per-user configuration file.
[user]
name = Patryk Seweryn
email = patryk.seweryn@digica.com

[includeIf "gitdir:~/apps/personal/"]
	path=~/.config/git/config-personal
[core]
	excludesFile = ~/.config/git/ignore
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[init]
	defaultBranch = main
[pull]
	rebase = true
[help]
	autocorrect = prompt
