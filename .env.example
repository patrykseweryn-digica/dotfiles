EDITOR=vim

# Install groups for this machine: core, agents, desktop (core is required).
# Comma-separated, for example: DOTFILES_GROUPS=core,agents
# Empty selects all groups.
DOTFILES_GROUPS=

# Optional explicit primary Firstmate home (absolute path, config/ must exist).
# Never inferred from FM_HOME, which may refer to a running secondmate.
DOTFILES_FIRSTMATE_HOME=
