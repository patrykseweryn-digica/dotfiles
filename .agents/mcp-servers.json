{
  "chrome-devtools": {
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--browserUrl",
      "http://127.0.0.1:9222"
    ],
    "command": "npx",
    "type": "stdio"
  },
  "cloudflare": {
    "type": "http",
    "url": "https://bindings.mcp.cloudflare.com/mcp"
  },
  "exa": {
    "type": "http",
    "url": "https://mcp.exa.ai/mcp"
  },
  "garmin": {
    "args": [
      "--from",
      "git+https://github.com/Taxuspt/garmin_mcp",
      "garmin-mcp"
    ],
    "command": "uvx",
    "type": "stdio"
  },
  "garmin-givemydata": {
    "args": [
      "--from",
      "garmin-givemydata",
      "garmin-mcp"
    ],
    "command": "uvx",
    "type": "stdio"
  },
  "logfire": {
    "type": "http",
    "url": "https://logfire-us.pydantic.dev/mcp"
  },
  "obsidian": {
    "args": [
      "mcp-obsidian"
    ],
    "command": "uvx",
    "type": "stdio"
  },
  "openaiDeveloperDocs": {
    "type": "http",
    "url": "https://developers.openai.com/mcp"
  },
  "playwright": {
    "args": [
      "-y",
      "@playwright/mcp@latest"
    ],
    "command": "npx",
    "type": "stdio"
  },
  "sequential-thinking": {
    "args": [
      "-y",
      "@modelcontextprotocol/server-sequential-thinking@latest"
    ],
    "command": "npx",
    "type": "stdio"
  },
  "telegram": {
    "args": [
      "--from",
      "git+https://github.com/chigwell/telegram-mcp",
      "telegram-mcp"
    ],
    "command": "uvx",
    "type": "stdio"
  },
  "todoist": {
    "type": "http",
    "url": "https://ai.todoist.net/mcp"
  }
}
